{
    "name": "hellforged",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@9.12.3",
    "scripts": {
        "start": "npm run dev",
        "build": "vite build",
        "lint": "eslint \"**/*.{ts,tsx}\" && prettier --check \"**/*.{ts,tsx}\"",
        "lint:fix": "eslint . --fix && prettier --write .",
        "cycles": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src",
        "typecheck": "tsc",
        "sim": "node --disable-warning=ExperimentalWarning scripts/simulate.ts",
        "format": "prettier --write .",
        "dev": "vite",
        "prepare": "husky"
    },
    "dependencies": {
        "@pixi/layout": "^2.0.1",
        "@pixi/ui": "^2.3.2",
        "howler": "^2.2.4",
        "marked": "^18.0.7",
        "pixi.js": "^8.19.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@assetpack/core": "^1.7.0",
        "@eslint/js": "^9.21.0",
        "@tweakpane/core": "^2.0.5",
        "@types/howler": "^2.2.13",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^4.7.0",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.1.2",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-react-hooks": "^7.1.1",
        "husky": "^9.1.7",
        "madge": "^8.0.0",
        "prettier": "^3.5.3",
        "sharp": "^0.35.3",
        "tweakpane": "^4.0.5",
        "typescript": "~5.7.3",
        "typescript-eslint": "^8.25.0",
        "vite": "^6.2.0",
        "vite-plugin-checker": "^0.14.5"
    }
}
